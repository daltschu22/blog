---
import '../styles/main.css';
import { Font } from 'astro:assets';
import { pathFor } from '../lib/posts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeMode from '../components/ThemeMode.astro';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title = "daltschu22's blog",
  description = 'Posts on solar hardware, radio protocols, and home automation.',
  image = pathFor('images/solarcity/original-solarcity-collector-wide.jpg'),
  article = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <ThemeMode />
    <Font cssVariable="--font-primary" preload />
    <meta name="generator" content={Astro.generator} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="daltschu22's blog" href={pathFor('rss.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="daltschu22's blog" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="min-h-[60vh]"><slot /></main>
    <Footer />
  </body>
</html>
