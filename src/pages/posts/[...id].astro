---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostMeta from '../../components/PostMeta.astro';
import { humanize, publishedPosts, pathFor } from '../../lib/posts';
export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, project, image, imageAlt, imageWidth, imageHeight } = post.data;
const schema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: title, description,
  datePublished: date.toISOString(), dateModified: (updated || date).toISOString(),
  author: { '@type': 'Person', name: 'daltschu22', url: 'https://github.com/daltschu22' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...(image && { image: new URL(pathFor(image), Astro.site).href }),
};
---
<Base title={`${title} — daltschu22`} {description} image={image ? pathFor(image) : undefined} article>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  </Fragment>
  <section class="section"><div class="container">
    <article class="row justify-center">
      <header class="md:col-10 text-center">
        <h1 class="h2">{title}</h1>
        <div class="mt-4"><PostMeta {date} {tags} centered /></div>
        {updated && <p class="mt-2 text-sm text-text">Updated <time datetime={updated.toISOString()}>{updated.toLocaleDateString('en-US', { timeZone: 'UTC' })}</time></p>}
      </header>
      {image && <div class="col-12 mt-8 mb-2"><Image src={pathFor(image)} width={imageWidth ?? 1000} height={imageHeight ?? 500} alt={imageAlt ?? title} class="post-cover rounded-lg" loading="eager" /></div>}
      <div class="md:col-10">
        <div class="content mb-16 text-left"><Content /></div>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <ul class="flex flex-wrap gap-3">{tags.map(tag => <li><a href={pathFor(`tags/${encodeURIComponent(tag)}/`)} class="block rounded-lg bg-light px-4 py-2 font-semibold text-dark text-sm hover:text-primary">#{humanize(tag)}</a></li>)}</ul>
          {project && <a href={project} class="text-primary hover:underline">Code and setup ↗</a>}
        </div>
        <p class="mt-10"><a href={pathFor('posts/')} class="text-primary hover:underline">← All posts</a></p>
      </div>
    </article>
  </div></section>
</Base>
