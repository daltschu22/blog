---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import { publishedPosts } from '../../lib/posts';

const posts = await publishedPosts();
---

<Base title="Posts — daltschu22" description="All posts on solar hardware, radio protocols, and home automation.">
  <Breadcrumb current="Posts" />
  <h1 class="text-2xl font-semibold sm:text-3xl">Posts</h1>
  <p class="mt-2 mb-6 italic">All published articles, newest first.</p>
  <ul>
    {posts.map(post => <Card {...post} />)}
  </ul>
</Base>
