---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';
import { humanize, publishedPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
  return tags.map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) } }));
}
interface Props { tag: string; posts: CollectionEntry<'posts'>[] }
const { tag, posts } = Astro.props;
---
<Base title={`${humanize(tag)} — daltschu22`} description={`Blog posts tagged ${tag}.`}>
  <section class="section"><div class="container"><h1 class="h2 page-heading">{humanize(tag)}</h1><PostGrid {posts} /></div></section>
</Base>
