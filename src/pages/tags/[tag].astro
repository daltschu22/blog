---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
import { publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
  return tags.map(tag => ({
    params: { tag },
    props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'posts'>[];
}
const { tag, posts } = Astro.props;
---

<Base title={`${tag} — daltschu22`} description={`Blog posts tagged ${tag}.`}>
  <Breadcrumb current={tag} parent={{ label: 'Tags', path: 'tags/' }} />
  <h1 class="text-2xl font-semibold sm:text-3xl">Tag: {tag}</h1>
  <p class="mt-2 mb-6 italic">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  <ul>
    {posts.map(post => <Card {...post} />)}
  </ul>
</Base>
