---
import Base from '../layouts/Base.astro';
import { publishedPosts, pathFor, formatDate, readingMinutes } from '../lib/posts';

const posts = await publishedPosts();
---
<Base>
  <section class="intro shell">
    <h1>Projects<br />and notes</h1>
    <p class="intro-description">Solar hardware, radio protocols, and home automation.</p>
  </section>
  <section id="articles" class="articles shell" aria-labelledby="articles-heading">
    <div class="section-heading"><h2 id="articles-heading">Posts</h2><span>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span></div>
    {posts.map((post, index) => (
      <article class="post-preview">
        <div class="post-preview-copy">
          <p class="post-number">{String(posts.length - index).padStart(2, '0')} <span>/</span> {post.data.tags.join(' · ')}</p>
          <h3><a href={pathFor(`posts/${post.id}/`)}>{post.data.title}</a></h3>
          <p class="post-description">{post.data.description}</p>
          <p class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span aria-hidden="true">·</span><span>{readingMinutes(post.body)} min read</span></p>
          <a class="read-link" href={pathFor(`posts/${post.id}/`)}>Read the article <span aria-hidden="true">↗</span></a>
        </div>
        {post.data.image && <a class="post-preview-image" href={pathFor(`posts/${post.id}/`)} tabindex="-1" aria-hidden="true"><img src={pathFor(post.data.image)} alt="" width="721" height="1280" /></a>}
      </article>
    ))}
  </section>
</Base>
