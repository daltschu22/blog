---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import LinkButton from '../components/LinkButton.astro';
import IconArrowRight from '../assets/icons/IconArrowRight.svg';
import { publishedPosts, pathFor } from '../lib/posts';

const posts = await publishedPosts();
---

<Base>
  <section id="articles" class="pt-12 pb-6" aria-labelledby="posts-heading">
    <h1 id="posts-heading" class="text-2xl font-semibold tracking-wide">Recent posts</h1>
    <ul>
      {posts.slice(0, 4).map(post => <Card {...post} />)}
    </ul>
  </section>
  <div class="my-8 text-center">
    <LinkButton href={pathFor('posts/')}>
      All posts <IconArrowRight aria-hidden="true" class="size-6" />
    </LinkButton>
  </div>
</Base>
