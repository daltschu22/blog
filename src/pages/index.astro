---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import { pathFor, publishedPosts } from '../lib/posts';
const posts = await publishedPosts();
---
<Base>
  <section class="section"><div class="container">
    <h1 class="sr-only">Recent posts</h1>
    <PostGrid posts={posts.slice(0, 5)} />
    {posts.length > 5 && <div class="mt-16 text-center"><a href={pathFor('posts/')} class="btn btn-outline-primary">All posts</a></div>}
  </div></section>
</Base>
