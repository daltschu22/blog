---
import Base from '../layouts/Base.astro';
import LinkButton from '../components/LinkButton.astro';
import { pathFor } from '../lib/posts';
---

<Base title="Page not found — daltschu22" noindex>
  <div class="flex min-h-[55svh] flex-col items-center justify-center text-center">
    <h1 class="text-accent text-8xl font-bold sm:text-9xl">404</h1>
    <p class="mt-4 text-2xl sm:text-3xl">Page not found</p>
    <LinkButton href={pathFor()} class="my-6 text-lg underline decoration-dashed underline-offset-8">Back to the blog</LinkButton>
  </div>
</Base>
