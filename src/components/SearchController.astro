<script is:inline data-site-script="search">
  (() => {
    const input = document.getElementById('post-search');
    const status = document.getElementById('search-status');
    const cards = [...document.querySelectorAll('[data-search]')];
    const update = () => {
      const query = input.value.trim();
      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      for (const card of cards) {
        card.hidden = !words.every(word => card.dataset.search.includes(word));
        if (!card.hidden) count++;
      }
      status.textContent = query ? `${count} ${count === 1 ? 'post' : 'posts'} for “${query}”` : '';
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };
    input.value = new URLSearchParams(window.location.search).get('q') || '';
    input.addEventListener('input', update);
    input.form.addEventListener('submit', event => { event.preventDefault(); update(); });
    update();
  })();
</script>
