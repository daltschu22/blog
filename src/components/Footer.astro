---
import { pathFor } from '../lib/posts';
import IconGitHub from '../assets/icons/IconGitHub.svg';
const links = [
  { name: 'Home', url: pathFor() },
  { name: 'Posts', url: pathFor('posts/') },
  { name: 'Tags', url: pathFor('tags/') },
  { name: 'RSS', url: pathFor('rss.xml') },
  { name: 'Site source', url: 'https://github.com/daltschu22/blog' },
];
---
<footer class="section bg-footer">
  <div class="container text-center">
    <ul class="mb-8 flex flex-wrap justify-center gap-x-4 gap-y-2">{links.map(link => <li><a href={link.url} class="inline-block p-4 text-white/75 hover:text-white">{link.name}</a></li>)}</ul>
    <ul class="social-icons mb-8"><li><a href="https://github.com/daltschu22" aria-label="GitHub"><IconGitHub aria-hidden="true" class="w-4" /></a></li></ul>
    <p class="text-white/75">© {new Date().getUTCFullYear()} daltschu22 · Theme: <a href="https://github.com/themefisher/bookworm-light-astro">Bookworm Light</a></p>
  </div>
</footer>
