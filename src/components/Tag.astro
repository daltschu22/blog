---
import IconHash from '../assets/icons/IconHash.svg';
import { pathFor } from '../lib/posts';

interface Props {
  tag: string;
  size?: 'sm' | 'lg';
}
const { tag, size = 'lg' } = Astro.props;
---

<li>
  <a
    href={pathFor(`tags/${encodeURIComponent(tag)}/`)}
    class:list={[
      'flex items-center gap-0.5 border-foreground border-b-2 border-dashed hover:border-accent hover:text-accent focus-visible:text-accent',
      { 'text-sm': size === 'sm', 'text-lg': size === 'lg' },
    ]}
  >
    <IconHash aria-hidden="true" class:list={['opacity-80', { 'size-5': size === 'lg', 'size-4': size === 'sm' }]} />
    {tag}
  </a>
</li>
