---
import ThemeToggle from './ThemeToggle.astro';
import { pathFor } from '../lib/posts';
const links = [
  { name: 'Home', url: pathFor() },
  { name: 'Tags', url: pathFor('tags/') },
  { name: 'GitHub', url: 'https://github.com/daltschu22' },
];
---
<a href="#main-content" class="skip-link">Skip to content</a>
<header class="header pt-6">
  <nav class="navbar container" aria-label="Main navigation">
    <div class="order-0"><a href={pathFor()} class="navbar-brand block text-2xl font-bold text-dark">daltschu22's blog</a></div>
    <input id="nav-toggle" type="checkbox" class="sr-only" aria-label="Open navigation menu" />
    <label id="show-button" for="nav-toggle" class="order-2 flex cursor-pointer items-center text-dark md:order-1 md:hidden">
      <svg class="h-6 w-6 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V15z" /></svg>
    </label>
    <label id="hide-button" for="nav-toggle" class="order-2 hidden cursor-pointer items-center text-dark md:order-1">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg>
    </label>
    <ul id="nav-menu" class="navbar-nav order-3 hidden w-full md:order-1 md:flex md:w-auto">
      {links.map(link => <li class="nav-item"><a href={link.url} class="nav-link block" aria-current={Astro.url.pathname === link.url ? 'page' : undefined}>{link.name}</a></li>)}
    </ul>
    <div class="order-1 ml-auto flex items-center gap-1 md:order-2 md:ml-0">
      <ThemeToggle />
      <a href={pathFor('search/')} class="inline-block p-2 text-xl text-dark hover:text-primary" aria-label="Search" title="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
      </a>
    </div>
  </nav>
</header>
