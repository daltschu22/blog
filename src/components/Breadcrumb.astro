---
import { pathFor } from '../lib/posts';

interface Props {
  current: string;
  parent?: { label: string; path: string };
}
const { current, parent } = Astro.props;
---

<nav class="mt-8 mb-6" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2 font-light">
    <li><a href={pathFor()} class="opacity-80 hover:text-accent">Home</a></li>
    <li aria-hidden="true" class="opacity-70">»</li>
    {parent && <>
      <li><a href={pathFor(parent.path)} class="opacity-80 hover:text-accent">{parent.label}</a></li>
      <li aria-hidden="true" class="opacity-70">»</li>
    </>}
    <li><span aria-current="page" class="opacity-75">{current}</span></li>
  </ol>
</nav>
